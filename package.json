{
  "name": "limerence-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord Limerence : construit et gère un serveur de A à Z (catégories, salons texte ➥…emoji, salons vocaux, privés dynamiques) + panel admin web.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "nextjs",
    "render"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.27.0",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
