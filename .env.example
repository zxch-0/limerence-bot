# ============================================================
#  LIMERENCE BOT — variables d'environnement
#  Copie ce fichier en .env pour tester en local.
#  Sur Render, ces variables se remplissent dans le dashboard
#  (ou automatiquement via le Blueprint render.yaml).
# ============================================================

# ---------- Discord (OBLIGATOIRE en prod) ----------
# Token du bot : https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=
# Application ID (onglet General Information)
DISCORD_CLIENT_ID=
# Client Secret (onglet OAuth2) — sert à la connexion du panel
DISCORD_CLIENT_SECRET=
# ID du serveur à gérer (clic droit sur le serveur > Copier l'identifiant)
DISCORD_GUILD_ID=

# ---------- Panel admin ----------
# Secret de signature des sessions (laisse vide en local, généré par le Blueprint)
SESSION_SECRET=change-moi-en-local
# Ton ID Discord : accès admin garanti même sans permission sur le serveur
OWNER_DISCORD_ID=
# Autres admins autorisés à ouvrir le panel (IDs séparés par des virgules)
ADMIN_DISCORD_IDS=
# URL publique du panel (ex: https://limerence-bot.onrender.com)
# Laisse vide : détecté automatiquement via RENDER_EXTERNAL_URL
PUBLIC_URL=

# ---------- Persistance ----------
# Optionnel : si tu branches une base Postgres (Render/Neon/Supabase),
# la config, les confessions, les annonces et les logs y sont stockés.
# Sans DATABASE_URL, un fichier JSON est utilisé (effacé à chaque redéploiement
# sur le plan gratuit Render — la structure Discord reste la source de vérité).
DATABASE_URL=

# ---------- Options ----------
# Mode démo : le panel s'affiche avec des données fictives, sans bot connecté.
# Passe à "false" (ou supprime la ligne) pour utiliser le vrai bot.
DEMO_MODE=
# Auto-ping /health pour ne pas s'endormir sur Render (minutes, 0 = désactivé)
KEEPALIVE_MINUTES=10
# Salons vocaux temporaires : nombre max par membre (0 = illimité)
TEMP_ROOMS_PER_USER=0
